# ─────────────────────────────────────────────────────────────────────────────
#  RedTaxi backend — environment configuration
#  Copy to .env and fill in.  Never commit .env.  Validated by src/config/env.js
#  at boot — the process refuses to start if a required value is missing/invalid.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
# Public base URL of this API (used in webhook/callback URLs)
API_BASE_URL=http://localhost:4000

# ── Database ────────────────────────────────────────────────────────────────
# mysql  = real MySQL/MariaDB (production + normal dev)
# memory = in-process store, NO database. Dev/demo/tests only — lets the OTP +
#          profile flow run with zero external services. Forbidden in production.
DB_DRIVER=mysql

# ── Database (MySQL 8 / MariaDB) — required when DB_DRIVER=mysql ─────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=redtaxi
DB_PASSWORD=change-me
DB_NAME=redtaxi
# Pool size — the single most important scale knob. Microlab's hard-coded 10
# was a load-test bottleneck; size this to your DB's max_connections budget.
DB_POOL_SIZE=20

# ── Redis (Socket.IO adapter, rate-limit store, dispatch locks) ──────────────
# Leave REDIS_URL empty in local dev to use in-memory fallbacks (single instance
# only — never run multi-instance without Redis).
REDIS_URL=redis://127.0.0.1:6379

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=generate-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=30d
OTP_TTL_SECONDS=300
OTP_LENGTH=4
# Dev-only: when true, /auth/otp/verify also accepts this code for any number.
# MUST be unset/false in staging + production.
OTP_DEV_BYPASS_CODE=

# Server-to-server secret for admin-web batch jobs / webhooks (HMAC-SHA256)
ADMIN_HMAC_SECRET=another-long-random-string

# ── SMS provider (OTP delivery) ─────────────────────────────────────────────
SMS_PROVIDER=console        # console | ping4sms | msg91 | twilio
SMS_API_KEY=
SMS_SENDER_ID=
SMS_TEMPLATE_ID=

# ── Firebase Cloud Messaging (push) ─────────────────────────────────────────
# Path to the service-account JSON (kept OUTSIDE the repo). If unset, push is
# silently disabled (dev-friendly).
FIREBASE_SERVICE_ACCOUNT_PATH=

# ── Maps (server-side routing / geocoding — key never ships in the apps) ─────
GOOGLE_MAPS_SERVER_KEY=

# ── Payments (Razorpay sandbox during development) ──────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Dispatch tuning ────────────────────────────────────────────────────────
DISPATCH_SEARCH_RADIUS_KM=5
DISPATCH_OFFER_TIMEOUT_MS=25000
DISPATCH_MAX_DRIVERS=8
DISPATCH_NO_DRIVER_TIMEOUT_MS=120000
DRIVER_OFFLINE_SWEEP_SECONDS=90

# ── Earnings / tracking ────────────────────────────────────────────────────
COMMISSION_PCT=20
TRACK_LOG_MIN_INTERVAL_MS=5000
TRACK_LOG_MIN_MOVE_M=40
